# Copy to .env.local for development. Set the same names in Vercel for production.
# Server-only unless prefixed NEXT_PUBLIC_.

# Site
NEXT_PUBLIC_SITE_URL=https://example.com

# $0 RULE: never add a credit card to any of these accounts.

# Database (Neon Free plan via Vercel Marketplace, or Supabase Free plan)
DATABASE_URL=            # pooled; used by the app
DATABASE_URL_UNPOOLED=   # direct; used by `pnpm db:migrate`

# Maps (Mapbox no-credit-card trial; URL-restricted public token)
NEXT_PUBLIC_MAPBOX_TOKEN=

# AI image editing: gallery | gemini | cloudflare | mock  (gallery = pre-rendered, always $0)
IMAGE_PROVIDER=gallery
IMAGE_MODEL=            # cloudflare: @cf/black-forest-labs/flux-2-klein-4b. Confirm in provider docs
GEMINI_API_KEY=         # free Google AI Studio key, billing NOT enabled
CLOUDFLARE_ACCOUNT_ID=  # Workers AI free daily allocation
CLOUDFLARE_API_TOKEN=
RENDER_DAILY_CAP=40     # below Cloudflare's free 10,000 neurons/day (≈ 53 edits at 1536×1024)

# Notifications
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=             # long random string; subscribe on the demo phone (no account needed)

# Rate limiting (stored in Postgres)
IP_HASH_SALT=

# Optional start times for the counters (ISO with offset; Arizona is -07:00)
# LIVE_SINCE empty = start of today, Arizona. INSIGHTS_SINCE empty = all stored data.
LIVE_SINCE=
INSIGHTS_SINCE=

# Mocks for tests and demo mode (1 = on)
MOCK_IMAGE_PROVIDER=0
MOCK_NOTIFY=0
MOCK_DB=0
